rules_version = '2';

// Only signed-in members of a group can upload/view/download files that
// belong to that group. This checks group membership by reading the
// matching Firestore document (cross-service rules).
service firebase.storage {
  match /b/{bucket}/o {
    match /groups/{groupId}/media/{allPaths=**} {
      allow read, write: if request.auth != null &&
        request.auth.uid in
          firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }
  }
}
